      "description": "Review public evidence for reentry.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "observation_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Observation Ids",
            "type": "array"
          }
        },
        "required": [
          "observation_ids"
