        "title": "ReviewArgs",
        "type": "object"
      },
      "kind": "read_only",
      "name": "arx.review_reentry",
      "output_schema": {
        "$defs": {
          "ReentryAssessment": {
            "additionalProperties": false,
            "properties": {
              "checks": {
                "items": {
                  "$ref": "#/$defs/ReentryCheck"
                },
                "minItems": 1,
                "title": "Checks",
                "type": "array"
              },
              "observation_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "title": "Observation Id",
                "type": "string"
              },
              "policy_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "title": "Policy Id",
                "type": "string"
              },
              "recovery_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "title": "Recovery Id",
                "type": "string"
              },
              "schema_version": {
                "const": "arx.reentry.assessment.v1",
                "default": "arx.reentry.assessment.v1",
                "title": "Schema Version",
                "type": "string"
              },
              "status": {
                "enum": [
                  "eligible",
                  "ineligible",
                  "unknown"
                ],
                "title": "Status",
                "type": "string"
              }
            },
            "required": [
              "recovery_id",
              "observation_id",
              "policy_id",
              "status",
              "checks"
            ],
            "title": "ReentryAssessment",
            "type": "object"
          },
          "ReentryCheck": {
            "additionalProperties": false,
            "properties": {
              "check_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "title": "Check Id",
                "type": "string"
              },
              "evidence_ids": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "type": "string"
                },
                "title": "Evidence Ids",
                "type": "array"
              },
              "reason_code": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "title": "Reason Code",
                "type": "string"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown"
                ],
                "title": "Status",
                "type": "string"
              }
            },
            "required": [
              "check_id",
              "status",
              "evidence_ids",
              "reason_code"
            ],
            "title": "ReentryCheck",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "assessment": {
            "$ref": "#/$defs/ReentryAssessment"
          },
          "reentry_token": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reentry Token"
          }
        },
        "required": [
          "assessment",
          "reentry_token"
        ],
        "title": "ReviewOutput",
        "type": "object"
